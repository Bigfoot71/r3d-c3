module r3d;

// ========================================
// ENUMS TYPES
// ========================================

<*
 Flags controlling importer behavior.

 These flags define how the importer processes the source asset.

 A sensible baseline of post-processing (triangulation, UV generation,
 tangent space, etc.) is always applied regardless of these flags;
 they only control situational behavior.
*>
bitstruct R3DImportFlags : uint
{
    bool retain_mesh_data;  // Keep a CPU-side copy of mesh data. When enabled, raw mesh data is preserved in RAM after model import and stored in `mesh_data`. Required if you need CPU-side access to geometry after import, e.g. for collision detection or custom mesh processing.
    bool retain_mesh_names; // Import and store mesh names from the model file. When enabled, mesh names are retrieved during import and stored in `mesh_names`. Useful for debugging, logging, or looking up a specific mesh by name at runtime.
    bool smooth_normals;    // Generate smooth normals for meshes that lack them. Existing normals are always preserved as-is. For meshes without normals, flat (per-face) normals are generated by default; enabling this flag generates smooth normals instead.
    bool optimize_mesh;     // Optimize mesh topology for runtime rendering. When enabled, indices are reordered to improve GPU vertex cache usage, and overly large meshes are split into smaller ones. This increases import time but can improve rendering performance. Recommended for assets baked offline or imported in an editor; usually unnecessary for quick runtime loading.
    bool validate_data;     // Validate mesh data and detect degenerate geometry. When enabled, the importer checks for and flags degenerate triangles and invalid data (e.g. malformed normals or UVs). Useful for catching broken assets early, but adds extra processing time.
}

<*
 Enable high-quality import processing.

 Shortcut combining `smooth_normals`, `optimize_mesh` and `validate_data`.
 Intended for editor usage and offline asset processing, where import time
 matters less than mesh quality and correctness.

 When disabled, a faster import path is used, better suited for runtime loading.
*>
const R3DImportFlags IMPORT_QUALITY = {
	.smooth_normals = true,
	.optimize_mesh = true,
	.validate_data = true
};

// ========================================
// STRUCTS TYPES
// ========================================

<*
 Opaque importer handle.

 Represents a loaded asset file that can be used to extract multiple
 resources (models, skeletons, animations) without re-importing the file.
*>
typedef R3DImporter = void;

// ========================================
// PUBLIC API
// ========================================

<*
 Load an importer from a file.

 Creates an importer instance from the specified file path.
 The file is parsed once and can be reused to extract multiple
 resources such as models and animations.

 @param file_path : `path to the asset file`
 @param flags : `importer behavior flags`
 @return `pointer to a new importer instance, or NULL on failure`
*>
extern fn R3DImporter* load_importer(ZString file_path, R3DImportFlags flags) @cname("R3D_LoadImporter");

<*
 Load an importer from a memory buffer.

 Creates an importer instance from in-memory asset data.
 This is useful for embedded assets or streamed content.

 @param data : `pointer to the asset data`
 @param size : `size of the data buffer in bytes`
 @param hint : `optional file format hint (may be NULL)`
 @param flags : `importer behavior flags`
 @return `pointer to a new importer instance, or NULL on failure`
*>
extern fn R3DImporter* load_importer_from_memory(void* data, uint size, ZString hint, R3DImportFlags flags) @cname("R3D_LoadImporterFromMemory");

<*
 Destroy an importer instance.

 Frees all resources associated with the importer.
 Any models or animations extracted from it remain valid.

 @param importer : `importer instance to destroy`
*>
extern fn void unload_importer(R3DImporter* importer) @cname("R3D_UnloadImporter");
